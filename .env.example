# Copy to .env.local (gitignored) and fill in. scripts/lib/dv.mjs loads it automatically; a variable
# already set in your shell wins. Use DV_ENV_FILE=<path> to keep one file per environment.
# NEVER put a token or password here - the token comes from `az login` (or DV_TOKEN for one shell).

# --- The one environment the scripts may touch (both required, must match) ---------------------
DV_ORG=https://<your-org>.crm4.dynamics.com
DV_ALLOWED_ORG=https://<your-org>.crm4.dynamics.com

# The one real mailbox test sends may reach; its owner agreed to receive test mail. Blank = none.
DV_APPROVED_RECIPIENT=

# --- Ids that belong to this environment --------------------------------------------------------
# Copilot Service workspace app module id (create-case-form, revert-deploy, revert-s1, revert-s11).
# Find: appmodules?$select=appmoduleid,name&$filter=uniquename eq 'msdyn_CustomerServiceWorkspace'
DV_CSW_APP_ID=

# An existing contact used as the customer on seeded cases (seed.mjs, seed-n5.mjs).
# Find: contacts?$select=contactid,fullname&$top=5
DV_CONTACT_ID=

# A case the spikes work on (alternative to a .caseid file beside the script).
DV_CASE=

# Test send (s7-send.mjs): an approved service queue.
DV_CARE_QUEUE_ID=

# --- Spike scripts only: needed just to re-run that spike ---------------------------------------
DV_S1_SPIKE_FORM_ID=
DV_S1_SPIKE_PAGE_ID=
DV_S11_FORM_ID=
DV_R18_UNAPPROVED_QUEUE_ID=
DV_R18_MAILBOX_ID=
DV_R8_CHILD_CASE_ID=
DV_R8_PARENT_CASE_ID=
