<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="JHRB" constructor="CaseEmailClient" version="1.27.0"
           display-name-key="Case Email Client"
           description-key="Case-scoped email client: threaded reading, in-place reply, attachments, templates and signatures, for the Copilot Service Workspace Case form."
           control-type="virtual">
    <!-- Dataverse-only. Declaring no external service keeps the component non-premium. -->
    <external-service-usage enabled="false">
    </external-service-usage>

    <!-- Optional Case id input.
         Neither chosen placement needs it: `context.mode.contextInfo` carries the record on a FORM
         host, and both placements are form tabs (Case form tab, and a dedicated Case form opened as
         a session tab by an `Entity record` app tab template). Measured 2026-09-10 (S11).
         Kept as insurance for the documented custom-page fallback, where `contextInfo` is empty and
         the host must hand the record in as `Param("recordId")`. -->
    <property name="caseId" display-name-key="Case id"
              description-key="Case (incident) GUID. Leave unset on a form; bind Param(&quot;recordId&quot;) only on a custom page."
              of-type="SingleLine.Text" usage="input" required="false" />

    <!-- DO NOT DELETE THIS DATASET.
         Nothing reads it - we query through `context.webAPI`, which is what gives us the security
         trimming N4 needs. The declaration is a LAYOUT ANCHOR: it is what makes this a *dataset*
         control, and only a dataset control can occupy a whole form tab as a subgrid. Drop it and
         the control becomes a *field* control, which must be bound to a Case column and is sized
         like a field. That placement is the one S1 measured. -->
    <data-set name="emails" display-name-key="Emails">
    </data-set>

    <resources>
      <code path="index.ts" order="1"/>
      <css path="css/CaseEmailClient.css" order="1" />
      <!-- Virtual control: share the host's React and Fluent rather than bundling our own.
           These versions are what the platform actually injects at runtime. The build dependency
           in package.json is pinned to match - compiling against a newer Fluent lets TypeScript
           promise components the runtime does not have, and that failure only shows up in the
           published app. Fluent 9.68.0 was measured as NOT supported by this environment. -->
      <platform-library name="React" version="16.14.0" />
      <platform-library name="Fluent" version="9.46.2" />
    </resources>

    <feature-usage>
      <uses-feature name="WebAPI" required="true" />
      <uses-feature name="Utility" required="true" />
    </feature-usage>
  </control>
</manifest>
