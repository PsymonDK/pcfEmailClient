{
    "extends": "./node_modules/pcf-scripts/tsconfig_base.json",
    "compilerOptions": {
        "typeRoots": ["node_modules/@types"],
        // dompurify's CJS declaration ends in `export = _default`, and the pcf-scripts base sets
        // neither esModuleInterop nor allowSyntheticDefaultImports — so `import DOMPurify from
        // 'dompurify'` fails with TS1259. This flag is TYPE-CHECKING ONLY: it changes no emit, and
        // webpack does the CJS interop at bundle time. Preferred over esModuleInterop, which would
        // change emit semantics for the whole control including the React import.
        "allowSyntheticDefaultImports": true
    },
    // Test files are compiled by tsconfig.test.json, not by the control build. Without this,
    // `pcf-scripts build` type-checks them and fails on the vitest imports.
    "exclude": ["**/*.test.ts", "**/*.test.tsx", "**/__tests__/**", "vitest.config.ts", "node_modules"]
}
